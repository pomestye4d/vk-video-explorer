{
  "name": "@ldocs/websocket",
  "version": "0.0.1",
  "description": "Web socket communication with platform",
  "license": "MIT",
  "main": "./dist/index.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 4,
    "semi": true,
    "singleQuote": true,
    "useTabs": false,
    "printWidth": 88
  },
  "module": "dist/index.js",
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@faker-js/faker": "^10.6.0",
    "@types/jquery": "^4.0.1",
    "babel-loader": "^10.1.1",
    "size-limit": "^13.0.3",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite-dts": "^1.0.4"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "jquery": "^4.0.0",
    "tsdef": "^0.0.14",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.63.1"
  },
  "homepage": "https://gridnine.com/",
